* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
# Byte-exact runtime archives and accepted evidence originals must not be re-encoded.
# These files are addressed by SHA256 (evidence registry manifest / frozen source locks).
output/** -text
lean/** -text
webapp/evidence_registry.py -text
webapp/evidence_registry_manifest.json -text
